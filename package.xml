<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trainit_motion_runtime</name>
  <version>2.6.1</version>
  <description>TrainIt Motion Runtime: a robot-agnostic, multi-planner motion
    framework on top of MoveIt 2 (discrete PTP/LIN/CIRC, free-space OMPL/CHOMP,
    process-path planning, validation and metrics). Embeds the generic planning
    pipelines; robot-specific MoveIt configs plug in at launch time.</description>
  <maintainer email="ros.master.ai@gmail.com">fra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>   <!-- ament_python_install_package: the launch helper module -->

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>   <!-- scene_manager_node: a dynamically typed parameter's descriptor -->
  <depend>action_msgs</depend>   <!-- ServoTrack arbitration: is a trajectory execution in flight? -->
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>   <!-- ADR-0022: the FollowJointTrajectory point of an EEF axis -->
  <!-- ADR-0022: the end-effector state (EndEffectorState); a mandatory sibling since TMR 2.0.0.
       ADR-0026 (TMR 2.5.0): the grasp candidate (GraspCandidate, GraspCandidateArray) of 0.2.0 -->
  <depend version_gte="0.2.0">trainit_interfaces</depend>
  <depend>diagnostic_msgs</depend>   <!-- ADR-0026: a grasp candidate's metadata (KeyValue) -->
  <depend>shape_msgs</depend>
  <depend>moveit_core</depend>
  <depend>random_numbers</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_ros_move_group</depend>   <!-- capability_names.h: the runners' MoveIt start-up wait (vNext M2.7); and the move_group node -->
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>   <!-- Eigen in the sources and in the installed grasp_candidates.hpp -->
  <depend>tf2_geometry_msgs</depend>
  <depend>vision_msgs</depend>   <!-- the perception contract (Detection3DArray), consumed by DetectObject -->
  <depend>yaml-cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>geometric_shapes</depend>   <!-- scene loader: mesh -> shape_msgs/Mesh -->
  <build_depend>boost</build_depend>   <!-- scene_manager_node: boost::get on a geometric_shapes variant -->
  <exec_depend>resource_retriever</exec_depend>   <!-- resolve package:// mesh URIs -->


  <!-- planning plugins the runtime selects at launch -->
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_planners_chomp</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>ament_index_python</exec_depend>   <!-- the launch helper module (trainit_moveit_config.py) -->
  <exec_depend>python3-yaml</exec_depend>         <!-- the launch helper module (trainit_moveit_config.py) -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>sensor_msgs</test_depend>   <!-- vNext M2.5 harness: the fake joint_states -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
