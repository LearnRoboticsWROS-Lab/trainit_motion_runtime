<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by the TrainIt Setup Assistant (bin_picking). The emptying loop of ADR-0016: ranked candidates, a retry over the
     candidate index, a holding check after the lift, and a gated stall recovery. Every DOF is in config/bt_params.yaml.
     End-effector contract (ADR-0022 D5): device "main". A fault, or any failure while the cycle
     holds an object, ends the run with FAILURE: it never reads as "bin empty". -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Fr3wmlSuctionBinPicking">
      <Log message="fr3wml_suction bin picking (BT, data-driven): start"/>

      <MoveWaypoint waypoint="ready"/>
      <MoveWaypoint waypoint="pre_pick"/>

      <!-- The emptying loop. num_cycles="-1" runs until the operator stops it; set
           application.loop_cycles for a bounded run. -->
      <Repeat num_cycles="2">
        <Fallback name="Fr3wmlSuctionBinPickingCycle">
          <Sequence name="PickOneObject">
            <!-- The gate, reset as the FIRST step of every cycle: eef_fault holds the reason of a fault,
                 holding says the cycle holds an object (ADR-0022 D5). -->
            <Script code="eef_fault := ''; holding := 0"/>
            <!-- Relative steps (D-017) off a taught pose: derived once per cycle. -->
            <SetWaypointRelative waypoint="post_place" from="place" dz="0.100"/>

            <!-- One sampling per cycle, OUTSIDE the retry: the detector publishes BEST FIRST and that
                 order IS the ranking (ADR-0016 Decision 1). keep = the retry budget, so every
                 candidate the loop can try has a blackboard entry and no more. -->
            <DetectObject detector="red_object" class_id="object" target_frame="base_link" timeout_ms="1500" keep="3" out_key="detected.red_object" fault="{eef_fault}"/>

            <!-- The candidate index the retry advances. Set to -1 and incremented as the
                 FIRST step of each attempt, so attempt 1 reads candidate 0 (ADR-0016). -->
            <Script code="candidate := -1"/>
            <RetryUntilSuccessful num_attempts="3">
              <Sequence name="OneCandidate" _failureIf="eef_fault != ''">
                <Script code="candidate := candidate + 1"/>
                <SetWaypointFromDetection waypoint="pick" from="detected.red_object" index="{candidate}" dz="0.006" orientation="keep"/>
                <SetWaypointRelative waypoint="post_pick" from="pick" dz="0.050"/>
                <MoveWaypoint waypoint="pick"/>
                <CloseGripper eef="main" fault="{eef_fault}"/>
                <SetAttachedCollisionCheck value="true"/>
                <MoveWaypoint waypoint="post_pick"/>
                <!-- Did it actually come up: the device's own grasp state, fresh and with accepted evidence.
                     A verdict (NO_OBJECT) sends the retry to the next candidate; a fault ends the run. -->
                <VerifyGrasp eef="main" expect="held" fault="{eef_fault}"/>
              </Sequence>
            </RetryUntilSuccessful>
            <Script code="holding := 1"/>

            <SetAttachedCollisionCheck value="true"/>
            <MoveWaypoint waypoint="pre_place"/>
            <MoveWaypoint waypoint="place"/>
            <VerifyGrasp eef="main" expect="held" reason="{eef_fault}"/>
            <OpenGripper eef="main" reason="{eef_fault}"/>
            <VerifyGrasp eef="main" expect="released" reason="{eef_fault}"/>
            <Script code="holding := 0"/>
            <MoveWaypoint waypoint="post_place"/>
            <Sleep msec="100"/>
          </Sequence>
          <!-- THE BIN STALLED: either nothing was detected, or every candidate refused. Those are
               the same stall to an operator, so one branch treats both. -->
          <Fallback name="BinStalled" _failureIf="eef_fault != '' || holding == 1">
            <!-- The recovery STEP. What the channel "bin_agitator" ACTUATES is CELL I/O
                 (ADR-0013), not this application: a shake is a machine with an amplitude, a
                 frequency and a direction, and it lives in the cell's own I/O program. TSA emits
                 the semantic Cmd_/Sts_ handshake and nothing about the machine behind it. -->
            <Sequence name="RecoverFromStall">
              <Log message="bin stalled: pulsing bin_agitator"/>
              <EnableProcess channel="bin_agitator"/>
              <Sleep msec="100"/>
              <DisableProcess channel="bin_agitator"/>
            </Sequence>
            <Log message="bin empty"/>
          </Fallback>
        </Fallback>
      </Repeat>

      <Log message="fr3wml_suction bin picking (BT, data-driven): complete"/>
    </Sequence>
  </BehaviorTree>
</root>
