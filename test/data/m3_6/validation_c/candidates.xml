<!-- Generated by the TrainIt Setup Assistant (task_program). One BehaviorTree per task; waypoints and moves in config/bt_params.yaml, paths in config/paths.yaml. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <AddCollisionObject id="table" frame="base_link" dims="{scene_table_dims}" position="{scene_table_pos}"/>
      <SubTree ID="task_validation_c" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="task_validation_c">
    <Sequence>
      <DetectCandidates source="candidates" detector="grasp_provider" target_frame="base_link" timeout_ms="3000" keep="1" out_key="parts"/>
      <SetWaypointFromCandidate from="parts" index="0" grasp="validation_c__s2_grasp" pregrasp="validation_c__s2_pregrasp" retract="validation_c__s2_retract" standoff_m="0.05" retract_along_approach="0.1" orientation="align_approach" orientation_from="pick_nominal" eef="main" site="main"/>
      <MoveWaypoint waypoint="validation_c__s2_pregrasp"/>
      <MoveWaypoint waypoint="validation_c__s2_grasp"/>
      <CloseGripper eef="main" site="main"/>
      <VerifyGrasp eef="main" site="main" expect="held"/>
      <MoveWaypoint waypoint="validation_c__s2_retract"/>
      <MoveWaypoint waypoint="validation_c__s3_prerelease"/>
      <MoveWaypoint waypoint="validation_c__s3_release"/>
      <VerifyGrasp eef="main" site="main" expect="held"/>
      <OpenGripper eef="main" site="main"/>
      <VerifyGrasp eef="main" site="main" expect="released"/>
      <MoveWaypoint waypoint="validation_c__s3_retract"/>
    </Sequence>
  </BehaviorTree>
</root>
