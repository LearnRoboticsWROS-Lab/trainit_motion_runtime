<?xml version="1.0" encoding="UTF-8"?>
<!-- Groot2 node model for the TrainIt Motion Runtime BT nodes.
     Include this in a Groot2 .btproj to edit trees with port dialogs offline. -->
<root BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="MoveWaypoint">
      <input_port name="waypoint"/>
      <!-- vNext M2.7: written only when the move failed for a reason that is not the target's -->
      <output_port name="fault">MOTION_FAULT: CAUSE during PHASE</output_port>
    </Action>
    <Action ID="MovePtp">
      <input_port name="joints" default=""/>
      <input_port name="named" default=""/>
      <input_port name="profile" default="transit"/>
    </Action>
    <Action ID="MoveToNamed">
      <input_port name="target"/>
      <input_port name="profile" default="transit"/>
      <input_port name="speed" default=""/>
      <input_port name="accel" default=""/>
    </Action>
    <Action ID="MoveToJoint">
      <input_port name="joints"/>
      <input_port name="profile" default="transit"/>
    </Action>
    <Action ID="MoveLinear">
      <input_port name="pose_key"/>
      <input_port name="tip_link" default=""/>
      <input_port name="profile" default="approach"/>
      <input_port name="speed" default=""/>
      <input_port name="accel" default=""/>
    </Action>
    <Action ID="MoveCircular">
      <input_port name="goal_key"/>
      <input_port name="aux"/>
      <input_port name="aux_is_center" default="false"/>
      <input_port name="tip_link" default=""/>
      <input_port name="profile" default="approach"/>
    </Action>
    <Action ID="MoveCollisionFree">
      <input_port name="pose_key" default=""/>
      <input_port name="joints" default=""/>
      <input_port name="named" default=""/>
      <input_port name="planner" default=""/>
      <input_port name="tip_link" default=""/>
      <input_port name="profile" default="transit"/>
      <input_port name="speed" default=""/>
      <input_port name="accel" default=""/>
    </Action>
    <Action ID="MoveFree">
      <input_port name="pose_key" default=""/>
      <input_port name="joints" default=""/>
      <input_port name="named" default=""/>
      <input_port name="planner" default=""/>
      <input_port name="tip_link" default=""/>
      <input_port name="profile" default="transit"/>
    </Action>
    <!-- ADR-0015 `execution: servo`: the same waypoint data, STREAMED to an
         out-of-process moveit_servo node instead of planned. See
         docs/behavior_tree_migration_plan.md for what each default is derived from. -->
    <Action ID="ServoTrack">
      <input_port name="waypoint"/>
      <input_port name="servo_node" default="servo_node"/>
      <input_port name="command_frame" default=""/>
      <input_port name="command_in_type" default="speed_units"/>
      <input_port name="linear_scale" default="0.4"/>
      <input_port name="angular_scale" default="0.8"/>
      <input_port name="tolerance_m" default="0.002"/>
      <input_port name="tolerance_deg" default="1.0"/>
      <input_port name="timeout_ms" default="5000"/>
      <input_port name="rate_hz" default="50"/>
      <input_port name="max_linear_vel" default="0.05"/>
      <input_port name="max_angular_vel" default="0.30"/>
      <input_port name="gain" default="2.0"/>
      <input_port name="execution_status_topic" default="execute_trajectory/_action/status"/>
      <input_port name="start_servo" default="true"/>
    </Action>
    <Action ID="ExecuteProcessPath">
      <input_port name="path_file"/>
      <input_port name="profile" default="process"/>
    </Action>
    <!-- vNext M3.1 (ADR-0024): one named path of the runner's paths_file, as ONE motion through
         the MotionRuntime door (a Pilz sequence, or a continuous Cartesian path). -->
    <Action ID="FollowPath">
      <input_port name="path">the path's name in the runner's paths_file</input_port>
      <input_port name="profile">the profile of a path that names none (approach)</input_port>
      <!-- vNext M3.5: an event-free run states[from..to] of the path (default: the whole path) -->
      <input_port name="from" default="">first state of the run (index; default 0)</input_port>
      <input_port name="to" default="">last state of the run (index; default the last state)</input_port>
      <output_port name="fault">MOTION_FAULT: CAUSE during PHASE (written only for a failure that is not the target's)</output_port>
    </Action>
    <!-- ADR-0022: with the canonical end-effector contract (an `eef` block in bt_params) the
         gripper nodes command a SITE's grip actuator and report reason/fault/subject on
         FAILURE; without it they run their legacy bodies and write nothing. -->
    <Action ID="OpenGripper">
      <input_port name="eef">ADR-0022: the device (default: the only one)</input_port>
      <input_port name="site">ADR-0022: the site (required on a multi-site device)</input_port>
      <output_port name="reason">on FAILURE: the ADR-0022 reason</output_port>
      <output_port name="fault">on FAILURE: the reason, unless it is a VERDICT</output_port>
      <output_port name="subject">on FAILURE: the identity the reason is about</output_port>
    </Action>
    <Action ID="CloseGripper">
      <input_port name="eef">ADR-0022: the device (default: the only one)</input_port>
      <input_port name="site">ADR-0022: the site (required on a multi-site device)</input_port>
      <output_port name="reason">on FAILURE: the ADR-0022 reason</output_port>
      <output_port name="fault">on FAILURE: the reason, unless it is a VERDICT</output_port>
      <output_port name="subject">on FAILURE: the identity the reason is about</output_port>
    </Action>
    <Action ID="SetGripper">
      <input_port name="position" default="1.0"/>
    </Action>
    <!-- ADR-0022: one actuator to one NAMED target, on its own standard interface. -->
    <Action ID="CommandActuator">
      <input_port name="eef">the device (default: the only one)</input_port>
      <input_port name="actuator">the actuator id</input_port>
      <input_port name="target">a NAMED target of the actuator</input_port>
      <input_port name="timeout_ms">replaces the device's command_timeout_ms</input_port>
      <output_port name="reason">on FAILURE: the ADR-0022 reason</output_port>
      <output_port name="fault">on FAILURE: the reason, unless it is a VERDICT</output_port>
      <output_port name="subject">on FAILURE: the identity the reason is about</output_port>
    </Action>
    <!-- ADR-0022 D4: the TOOL's grasp, at a site or tool level; never an actuator's command. -->
    <Action ID="VerifyGrasp">
      <input_port name="eef">the device (default: the only one)</input_port>
      <input_port name="site">the site (empty: the only one, or tool level)</input_port>
      <input_port name="expect">held | released</input_port>
      <input_port name="timeout_ms">default: the project's verification.timeout_ms</input_port>
      <input_port name="max_age_ms">default: the project's verification.max_age_ms</input_port>
      <input_port name="accept">narrows the accepted evidence, e.g. sensor</input_port>
      <output_port name="reason">on FAILURE: the ADR-0022 reason</output_port>
      <output_port name="fault">on FAILURE: the reason, unless it is a VERDICT</output_port>
      <output_port name="subject">on FAILURE: the identity the reason is about</output_port>
    </Action>
    <Action ID="EnableProcess">
      <input_port name="channel"/>
    </Action>
    <Action ID="DisableProcess">
      <input_port name="channel"/>
    </Action>
    <!-- vNext M3.5: the generic process event on a LOGICAL channel (EnableProcess / DisableProcess
         are its legacy aliases) -->
    <Action ID="ProcessEvent">
      <input_port name="kind">process_on | process_off | set_value | external</input_port>
      <input_port name="channel">a logical channel id (never a topic, a PLC address or a symbol)</input_port>
      <input_port name="value" default="">set_value: the value</input_port>
    </Action>
    <Action ID="AddCollisionObject">
      <input_port name="id"/>
      <input_port name="frame" default="base_link"/>
      <input_port name="dims"/>
      <input_port name="position" default="0;0;0"/>
    </Action>
    <Action ID="RemoveCollisionObject">
      <input_port name="id"/>
    </Action>
    <Action ID="AttachObject">
      <input_port name="id"/>
      <input_port name="link" default="tcp"/>
      <input_port name="dims"/>
      <input_port name="position" default="0;0;0"/>
    </Action>
    <Action ID="DetachObject">
      <input_port name="id"/>
      <input_port name="link" default="tcp"/>
    </Action>
    <Action ID="SetAttachedCollisionCheck">
      <input_port name="value"/>
      <input_port name="service" default="/scene_manager_node/attached_collision_check"/>
    </Action>
    <Action ID="SetReleasePolicy">
      <input_port name="policy" default="freeze"/>
      <input_port name="topic" default="/isaac_release_policy"/>
    </Action>
    <Action ID="MakePose">
      <input_port name="position"/>
      <input_port name="orientation" default=""/>
      <input_port name="rpy_deg" default=""/>
      <input_port name="out_key"/>
    </Action>
    <Action ID="StoreCurrentPose">
      <input_port name="pose_key"/>
    </Action>
    <Action ID="ComputeTcpTarget">
      <input_port name="target_xyz"/>
      <input_port name="tcp_offset_xyz" default="0;0;0"/>
      <input_port name="tcp_offset_rpy_deg" default="0;0;0"/>
      <input_port name="use_current_orientation" default="true"/>
      <input_port name="fixed_rpy_deg" default="0;0;0"/>
      <input_port name="quat" default=""/>
      <input_port name="out_key"/>
    </Action>
    <Action ID="OffsetPoseInToolFrame">
      <input_port name="in_key"/>
      <input_port name="dx" default="0.0"/>
      <input_port name="dy" default="0.0"/>
      <input_port name="dz" default="0.0"/>
      <input_port name="out_key"/>
    </Action>
    <Action ID="OffsetPoseInBaseFrame">
      <input_port name="in_key"/>
      <input_port name="dx" default="0.0"/>
      <input_port name="dy" default="0.0"/>
      <input_port name="dz" default="0.0"/>
      <input_port name="xyz" default=""/>
      <input_port name="out_key"/>
    </Action>
    <!-- perception: the Detection3DArray contract -> blackboard waypoints.
         `keep` and `index` are the ADR-0016 candidate list; both defaults are
         today's single-best behaviour, so an existing tree means the same thing. -->
    <Action ID="DetectObject">
      <input_port name="detector"/>
      <input_port name="topic" default=""/>
      <input_port name="class_id" default=""/>
      <input_port name="target_frame" default="base_link"/>
      <input_port name="timeout_ms" default="3000"/>
      <input_port name="min_score" default="0"/>
      <input_port name="keep" default="1"/>
      <input_port name="out_key" default="detected"/>
      <!-- vNext M3.5: true = a capture: trigger the detector, accept only a result taken after it began -->
      <input_port name="trigger" default="false"/>
      <!-- ADR-0022: written only when no fresh message arrived or a TF lookup failed -->
      <output_port name="fault">DETECTION_TIMEOUT | TF_LOOKUP_FAILED | TRIGGER_UNAVAILABLE</output_port>
    </Action>
    <Action ID="SetWaypointFromDetection">
      <input_port name="waypoint"/>
      <input_port name="from" default="detected"/>
      <input_port name="index" default="0"/>
      <input_port name="dx" default="0"/>
      <input_port name="dy" default="0"/>
      <input_port name="dz" default="0"/>
      <input_port name="orientation" default="keep"/>
      <input_port name="type" default="tcp"/>
    </Action>
    <Action ID="SetWaypointRelative">
      <input_port name="waypoint"/>
      <input_port name="from"/>
      <input_port name="dx" default="0"/>
      <input_port name="dy" default="0"/>
      <input_port name="dz" default="0"/>
      <input_port name="droll" default="0"/>
      <input_port name="dpitch" default="0"/>
      <input_port name="dyaw" default="0"/>
      <input_port name="type" default="tcp"/>
    </Action>
    <!-- vNext M3.6 (ADR-0026): the grasp-candidate contract -->
    <Action ID="DetectCandidates">
      <input_port name="source">candidates | detections</input_port>
      <input_port name="detector"/>
      <input_port name="topic" default=""/>
      <input_port name="target_frame" default="base_link"/>
      <input_port name="timeout_ms" default="3000"/>
      <input_port name="keep" default="1"/>
      <input_port name="out_key"/>
      <input_port name="class_id" default="">detections: keep this class only</input_port>
      <input_port name="min_score" default="">detections: the lowest hypothesis score</input_port>
      <input_port name="default_approach" default="">detections: the approach without a normal (target_frame)</input_port>
      <input_port name="standoff_m" default="">detections: the projected standoff</input_port>
      <input_port name="eef" default="">detections: the projected device</input_port>
      <input_port name="site" default="">detections: the projected site</input_port>
      <output_port name="reason"/>
      <output_port name="fault"/>
    </Action>
    <Action ID="SetWaypointFromCandidate">
      <input_port name="from"/>
      <input_port name="index" default="0"/>
      <input_port name="grasp"/>
      <input_port name="pregrasp"/>
      <input_port name="retract" default=""/>
      <input_port name="standoff_m" default="">replaces the candidate's standoff</input_port>
      <input_port name="retract_along_approach" default=""/>
      <input_port name="retract_dz" default=""/>
      <input_port name="orientation">align_approach</input_port>
      <input_port name="orientation_from">the reference waypoint of align_approach</input_port>
      <input_port name="eef" default=""/>
      <input_port name="site" default=""/>
      <output_port name="reason"/>
    </Action>
    <Action ID="Wait">
      <input_port name="duration_ms" default="100"/>
    </Action>
    <Action ID="Log">
      <input_port name="message"/>
    </Action>
  </TreeNodesModel>
</root>
