<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by the TrainIt Setup Assistant (task_program). One BehaviorTree per task; waypoints and moves in config/bt_params.yaml, paths in config/paths.yaml. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <AddCollisionObject id="table" frame="base_link" dims="{scene_table_dims}" position="{scene_table_pos}"/>
      <SubTree ID="task_cell_cycle" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="task_cell_cycle">
    <Sequence>
      <Sequence name="trainit_step:start:move">
        <MoveWaypoint waypoint="home"/>
      </Sequence>
      <Sequence name="trainit_step:conveyor_on:process">
        <ProcessEvent kind="process_on" channel="conveyor"/>
      </Sequence>
      <Sequence name="trainit_step:cycles:repeat">
        <Repeat num_cycles="2">
          <Sequence>
            <Sequence name="trainit_step:one_part:task">
              <SubTree ID="task_transfer" _autoremap="true"/>
            </Sequence>
          </Sequence>
        </Repeat>
      </Sequence>
      <ProcessEvent kind="process_off" channel="conveyor"/>
      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="2">
            <Sequence>
              <Sequence name="trainit_step:reach:move">
                <MoveWaypoint waypoint="out_of_reach"/>
              </Sequence>
            </Sequence>
          </RetryUntilSuccessful>
        </Sequence>
        <Sequence>
          <SubTree ID="task_go_home" _autoremap="true"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="task_transfer">
    <Sequence>
      <Sequence name="trainit_step:pick:grasp">
        <MoveWaypoint waypoint="transfer__s1_pregrasp"/>
        <MoveWaypoint waypoint="transfer__s1_grasp"/>
        <CloseGripper eef="main" site="main"/>
        <VerifyGrasp eef="main" site="main" expect="held"/>
        <MoveWaypoint waypoint="transfer__s1_retract"/>
      </Sequence>
      <Sequence name="trainit_step:place:release">
        <MoveWaypoint waypoint="transfer__s2_prerelease"/>
        <MoveWaypoint waypoint="transfer__s2_release"/>
        <VerifyGrasp eef="main" site="main" expect="held"/>
        <OpenGripper eef="main" site="main"/>
        <VerifyGrasp eef="main" site="main" expect="released"/>
        <MoveWaypoint waypoint="transfer__s2_retract"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="task_go_home">
    <Sequence>
      <MoveWaypoint waypoint="home"/>
      <Sleep msec="200"/>
    </Sequence>
  </BehaviorTree>
</root>
